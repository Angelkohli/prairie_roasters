<div class="container mt-4">
  <h2>Order Confirmed! ✅</h2>
  <p class="text-muted">Order #<%= @order.id %> — <%= @order.order_date.strftime('%B %d, %Y') %></p>

  <div class="card mb-4">
    <div class="card-header d-flex justify-content-between">
      <span>Order Details</span>
      <span class="badge bg-success"><%= @order.status.capitalize %></span>
    </div>
    <div class="card-body">
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Price</th>
            <th>Subtotal</th>
          </tr>
        </thead>
        <tbody>
          <% @order.order_items.each do |item| %>
            <tr>
              <td><%= item.product.name %></td>
              <td><%= item.quantity %></td>
              <td><%= number_to_currency(item.price_at_purchase) %></td>
              <td><%= number_to_currency(item.quantity * item.price_at_purchase) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr class="table-dark">
            <th colspan="3">Total</th>
            <th><%= number_to_currency(@order.total) %></th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <%= link_to "Continue Shopping", root_path, class: 'btn btn-dark' %>
  <%= link_to "View All Orders", orders_path, class: 'btn btn-outline-secondary ms-2' %>
</div>