<div class="container mt-4">
  <h2>Order #<%= @order.id %></h2>
  <p>Placed on <%= @order.order_date.strftime('%B %d, %Y at %I:%M %p') %></p>
  <p>Status: <span class="badge bg-<%= @order.status == 'delivered' ? 'success' : 'warning' %>"><%= @order.status.capitalize %></span></p>

  <h4 class="mt-4">Items</h4>
  <table class="table">
    <thead>
      <tr><th>Product</th><th>Quantity</th><th>Price</th><th>Subtotal</th></tr>
    </thead>
    <tbody>
      <% @order.order_items.each do |item| %>
        <tr>
          <td><%= item.product.name %></td>
          <td><%= item.quantity %></td>
          <td><%= number_to_currency(item.price_at_purchase) %></td>
          <td><%= number_to_currency(item.quantity * item.price_at_purchase) %></td>
        </tr>
      <% end %>
    </tbody>
   </table>

  <div class="row justify-content-end">
    <div class="col-md-4">
      <table class="table table-borderless">
        <tr><td>Subtotal:</td><td class="text-end"><%= number_to_currency(@order.subtotal) %></td></tr>
        <tr><td>Tax (<%= @order.customer.province&.name %>):</td><td class="text-end"><%= number_to_currency(@order.tax_amount) %></td></tr>
        <tr class="table-active"><th>Total:</th><th class="text-end"><%= number_to_currency(@order.total) %></th></tr>
      </table>
    </div>
  </div>

  <%= link_to "Back to Orders", orders_path, class: 'btn btn-outline-secondary' %>
</div>