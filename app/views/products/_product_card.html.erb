<div class="col">
  <div class="card h-100 shadow-sm position-relative">
    
    <%# Sale Badge %>
    <% if product.on_sale? %>
      <div class="position-absolute top-0 end-0 m-2">
        <span class="badge bg-danger fs-6" style="z-index: 10;">
          🔥 <%= product.discount_percentage %>% OFF
        </span>
      </div>
    <% end %>
    
    <% if product.image.attached? %>
      <%= image_tag url_for(product.image), class: 'card-img-top', alt: product.name, style: 'height: 200px; object-fit: cover;' %>
    <% else %>
      <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height:200px">
        <span class="text-white">No Image</span>
      </div>
    <% end %>
    
    <div class="card-body">
      <h3 class="card-title"><%= product.name %></h3>
      <p class="card-text text-muted small"><%= product.category.name %></p>
      <% if product.roast_level.present? %>
        <span class="badge bg-warning text-dark"><%= product.roast_level %></span>
      <% end %>
      <p class="card-text mt-2"><%= truncate(product.description, length: 80) %></p>
      
      <%# Price Display with Sale Pricing %>
      <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
          <% if product.on_sale? %>
            <span class="text-muted text-decoration-line-through me-2">
              <%= number_to_currency(product.original_price) %>
            </span>
            <strong class="text-danger fs-5">
              <%= number_to_currency(product.current_price) %>
            </strong>
          <% else %>
            <strong class="text-success fs-5">
              <%= number_to_currency(product.current_price) %>
            </strong>
          <% end %>
        </div>
        <%= link_to "View", product_path(product), class: 'btn btn-sm btn-outline-dark' %>
      </div>
    </div>
  </div>
</div>